DB_NAME=tharai
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

SECRET_KEY=change-me

FRONTEND_ORIGIN=http://localhost:8080
API_PORT=5001

# Course chatbot (routes_chat.py) — get a key from console.anthropic.com
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5

# Set to "production" on the live server — enables the Secure flag on
# session cookies (requires HTTPS). Leave unset for local dev over http.
FLASK_ENV=

# SMTP is optional for local dev — if SMTP_HOST is blank, emails are printed
# to the backend console instead of actually being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=no-reply@tharai.com
